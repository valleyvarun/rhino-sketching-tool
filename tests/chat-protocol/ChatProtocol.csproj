<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <MacTransport Condition="'$(MacTransport)' == '' and '$(OS)' != 'Windows_NT'">true</MacTransport>
    <TargetFramework Condition="'$(MacTransport)' != 'true'">net48</TargetFramework>
    <TargetFramework Condition="'$(MacTransport)' == 'true'">net8.0</TargetFramework>
    <DefineConstants Condition="'$(MacTransport)' == 'true'">$(DefineConstants);MAC</DefineConstants>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../rhino-plugin/Agent/EffortLevels.cs" Link="EffortLevels.cs" />
    <Compile Include="../../rhino-plugin/Agent/McpConfiguration.cs" Link="McpConfiguration.cs" />
    <Compile Include="../../rhino-plugin/Agent/ChatSession.cs" Link="ChatSession.cs" />
    <Compile Include="../../rhino-plugin/Agent/Providers/CodexSession.cs" Link="CodexSession.cs" />
    <Compile Include="../../rhino-plugin/Agent/IChatSession.cs" Link="IChatSession.cs" />
    <Compile Include="../../rhino-plugin/Agent/ChatAttachment.cs" Link="ChatAttachment.cs" />
    <Compile Include="../../rhino-plugin/Agent/ChatHistory.cs" Link="ChatHistory.cs" />
    <Compile Include="../../rhino-plugin/Agent/Providers/ClaudeCli.cs" Link="ClaudeCli.cs" />
    <Compile Include="../../rhino-plugin/Agent/Providers/CodexCli.cs" Link="CodexCli.cs" />
    <Compile Include="../../rhino-plugin/Mac/MacProcess.cs" Link="MacProcess.cs" />
    <Compile Include="../../rhino-plugin/Infrastructure/Json.cs" Link="Json.cs" />
    <Compile Include="../../rhino-plugin/Infrastructure/ChildProcess.cs" Link="ChildProcess.cs" />
  </ItemGroup>
</Project>
