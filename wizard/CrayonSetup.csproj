<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><LangVersion>latest</LangVersion>
    <AssemblyName>CrayonSetup</AssemblyName><RootNamespace>CrayonSetup</RootNamespace>
    <PlatformTarget>x64</PlatformTarget><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/crayon.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/><Reference Include="WindowsBase"/>
    <Reference Include="System.Xaml"/><Reference Include="System.Net.Http"/><Reference Include="System.Web.Extensions"/><Reference Include="System.IO.Compression"/>
    <Compile Include="Setup/*.cs"/>
    <Compile Include="../rhino-plugin/Agent/Providers/ClaudeCli.cs" Link="Shared/ClaudeCli.cs"/>
    <Compile Include="../rhino-plugin/Agent/Providers/CodexCli.cs" Link="Shared/CodexCli.cs"/>
    <Compile Include="../rhino-plugin/Infrastructure/ChildProcess.cs" Link="Shared/ChildProcess.cs"/>
    <EmbeddedResource Include="Setup/Window.xaml" LogicalName="CrayonSetup.Window.xaml"/>
    <EmbeddedResource Include="Assets/crayon-mark.png" LogicalName="CrayonSetup.logo.png"/>
    <EmbeddedResource Include="bin/payload/*.yak" LogicalName="CrayonSetup.plugin.yak"/>
    <EmbeddedResource Include="bin/payload/package-info.txt" LogicalName="CrayonSetup.package-info.txt"/>
  </ItemGroup>
</Project>
