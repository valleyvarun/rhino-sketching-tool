<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Crayon Setup" Width="620" Height="610" MinWidth="520" MinHeight="570" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F6F7F9"/><SolidColorBrush x:Key="Card" Color="White"/>
  <SolidColorBrush x:Key="Ink" Color="#23262C"/><SolidColorBrush x:Key="Muted" Color="#747A86"/>
  <SolidColorBrush x:Key="Line" Color="#E3E5E9"/><SolidColorBrush x:Key="Purple" Color="#9731B0"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="22,12"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9731B0"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="36,25,36,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="-8,0,0,20">
   <Image x:Name="Logo" Width="62" Height="62"/>
   <TextBlock Text="crayon" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
   <TextBlock x:Name="SetupVersion" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,5,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="Heading" Text="A little setup." FontSize="30" FontWeight="SemiBold" LineHeight="39"/>
    <TextBlock x:Name="Description" Text="Bring sketching, comments and your favourite agents into Rhino." Foreground="{DynamicResource Muted}" Margin="0,14,0,24" FontSize="15"/>
    <Border x:Name="Summary" CornerRadius="16" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22,18">
     <StackPanel>
      <TextBlock x:Name="RhinoStatus" Text="Finding Rhino 8…" FontWeight="SemiBold"/>
      <TextBlock Text="Crayon + RhinoMCP" Margin="0,16,0,0"/>
      <TextBlock Text="Claude Code + Codex" Margin="0,12,0,0"/>
      <TextBlock Text="Existing installations are reused." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,16,0,0"/>
     </StackPanel>
    </Border>
    <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,16,0,0">
     <ProgressBar x:Name="Progress" Height="6" Maximum="100" Foreground="{DynamicResource Purple}" Background="{DynamicResource Line}"/>
     <TextBlock x:Name="ProgressText" Margin="0,16,0,0"/>
     <TextBlock Text="Downloads can take a few minutes. You can leave this window open." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
    </StackPanel>
    <TextBlock x:Name="Note" Text="For Rhino 8 on Windows. Internet access is needed to install missing components." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,18,0,0"/>
    <TextBlock x:Name="Error" Foreground="#C14848" Margin="0,16,0,0" Visibility="Collapsed"/>
    <Button x:Name="Locate" Content="Find Rhino 8…" HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed"/>
    <CheckBox x:Name="LaunchRhino" Content="Open Rhino" IsChecked="True" Margin="0,22,0,0" Visibility="Collapsed"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,26,0,0">
   <Button x:Name="Secondary" Content="Cancel" HorizontalAlignment="Left"/>
   <Button x:Name="Primary" Content="Install Crayon" Background="{DynamicResource Purple}" BorderBrush="{DynamicResource Purple}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" IsDefault="True"/>
  </Grid>
 </Grid>
</Window>
