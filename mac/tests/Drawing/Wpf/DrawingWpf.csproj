<Project Sdk="Microsoft.NET.Sdk">

  <!-- The plug-in as it is compiled for Windows (painting with WPF), as a program that draws
       the viewport interface to picture files: what the Mac's painting is held against.
       See ../Program.cs and ../README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- for System.Drawing, which RhinoCommon speaks in -->
    <AssemblyName>DrawingWpf</AssemblyName>
    <RootNamespace>RhinoSketchingTool</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416;MSB3277</NoWarn>
    <RhinoSystem Condition="'$(RhinoSystem)' == ''">C:\Program Files\Rhino 8\System</RhinoSystem>
  </PropertyGroup>

  <ItemGroup>
    <!-- From the installed Rhino 8, and found there again when the program runs (not copied). -->
    <Reference Include="RhinoCommon" HintPath="$(RhinoSystem)\netcore\RhinoCommon.dll" Private="false" />
    <Reference Include="Rhino.UI" HintPath="$(RhinoSystem)\netcore\Rhino.UI.dll" Private="false" />
    <Reference Include="Eto" HintPath="$(RhinoSystem)\Eto.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../../rhino-plugin/**/*.cs" Exclude="../../../../rhino-plugin/bin/**;../../../../rhino-plugin/obj/**" LinkBase="Plugin" />
    <Compile Include="../Program.cs" />
  </ItemGroup>

</Project>
