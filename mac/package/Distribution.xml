<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Crayon @DISPLAY_VERSION@ for Rhino 8</title>
  <product id="com.crayon.rhino8" version="@VERSION@"/>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="never" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <volume-check script="true">
    <required-bundles description="Install Rhino 8 for Mac, then open the Crayon installer again.">
      <bundle id="com.mcneel.rhinoceros.8" path="Applications/Rhino 8.app" search="true"/>
    </required-bundles>
  </volume-check>
  <choices-outline>
    <line choice="crayon"/>
  </choices-outline>
  <choice id="crayon" title="Crayon" visible="false">
    <pkg-ref id="com.crayon.rhino8.setup"/>
  </choice>
  <pkg-ref id="com.crayon.rhino8.setup" version="@VERSION@">#Crayon.pkg</pkg-ref>
  <pkg-ref id="com.crayon.rhino8.setup">
    <must-close><app id="com.mcneel.rhinoceros.8"/></must-close>
  </pkg-ref>
</installer-gui-script>
