<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds bin\Release\RhinoSketchingTool.rhp for Rhino 8:
         dotnet build -c Release
       .NET Framework 4.8 is the target because one such build loads in Rhino 8 whether
       Rhino is running on .NET Core (the default) or on .NET Framework. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>RhinoSketchingTool</AssemblyName>
    <RootNamespace>RhinoSketchingTool</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Version>1.0.0</Version>
    <Title>Rhino Sketching Tool</Title>
    <Description>Freehand 3D sketching: draw on object surfaces, on the construction plane, or at a 3D cursor, and erase whole strokes or parts of them.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the Rhino 8.0 API so the plug-in runs on every Rhino 8 service release.
         Rhino supplies these assemblies at run time, so they are not copied to the output. -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
